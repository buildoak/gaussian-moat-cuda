{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaussian-moat.local/schemas/source-dead-cert-draft.schema.json",
  "title": "LB source dead certificate draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "certificate_id",
    "profile_id",
    "metadata",
    "k_sq",
    "terminal_radius",
    "negative_guard_pass",
    "endpoint",
    "endpoint_atom_id",
    "source_path_provenance",
    "source_path",
    "terminal_source_inventory_summary"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal_source_inventory_mode": {
            "const": "summary_only_non_claim"
          }
        },
        "required": ["terminal_source_inventory_mode"]
      },
      "then": {
        "required": ["proof_status", "non_claim"],
        "properties": {
          "proof_status": { "const": "SUMMARY_ONLY_NON_CLAIM" }
        },
        "not": { "required": ["terminal_source_inventory"] }
      },
      "else": {
        "required": ["terminal_source_inventory"],
        "not": {
          "anyOf": [
            { "required": ["proof_status"] },
            { "required": ["non_claim"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "geometry_id": { "const": "SOURCE_ORIGIN_K26" }
            },
            "required": ["geometry_id"]
          }
        },
        "required": ["metadata"]
      },
      "then": {
        "properties": {
          "k_sq": { "const": 26 },
          "terminal_radius": { "const": 1015645 },
          "endpoint": {
            "properties": {
              "a": { "const": 376039 },
              "b": { "const": 943460 },
              "norm_sq": { "const": 1031522101121 }
            }
          },
          "endpoint_atom_id": { "const": 1615075207964004 },
          "source_path": {
            "minItems": 2,
            "prefixItems": [
              {
                "type": "object",
                "required": ["a", "b", "norm_sq"],
                "properties": {
                  "norm_sq": { "maximum": 26 }
                }
              }
            ],
            "contains": {
              "type": "object",
              "required": ["a", "b", "norm_sq"],
              "properties": {
                "a": { "const": 376039 },
                "b": { "const": 943460 },
                "norm_sq": { "const": 1031522101121 }
              }
            }
          },
          "metadata": {
            "properties": {
              "source_mode": {
                "const": "ORIGIN_SOURCE"
              },
              "bz_status": {
                "const": "BZ_REPAIRED_SCHEDULE_PASS_NON_SOURCE"
              }
            }
          },
          "terminal_source_inventory_summary": {
            "properties": {
              "count": { "const": 14542615005 },
              "max_norm_sq": { "const": 1031522101121 },
              "max_norm_atom_ids": {
                "contains": { "const": 1615075207964004 }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema": { "const": "lb_source_dead_cert_draft_v1" },
    "certificate_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "proof_status": {
      "enum": ["SUMMARY_ONLY_NON_CLAIM"]
    },
    "non_claim": { "type": "string", "minLength": 1 },
    "terminal_source_inventory_mode": {
      "enum": ["listed", "summary_only_non_claim"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_mode",
        "source_id",
        "geometry_id",
        "commit_id",
        "build_id",
        "bz_status",
        "artifact_hash"
      ],
      "properties": {
        "source_mode": {
          "enum": ["ORIGIN_SOURCE", "WIRED_SOURCE", "CERTIFIED_SEED"]
        },
        "source_id": { "type": "string", "minLength": 1 },
        "geometry_id": { "type": "string", "minLength": 1 },
        "commit_id": { "type": "string", "minLength": 1 },
        "build_id": { "type": "string", "minLength": 1 },
        "bz_status": { "type": "string", "minLength": 1 },
        "artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "k_sq": { "type": "integer", "minimum": 1 },
    "terminal_radius": { "type": "integer", "minimum": 1 },
    "negative_guard_pass": { "type": "boolean" },
    "endpoint": { "$ref": "#/$defs/source_path_point" },
    "endpoint_atom_id": { "type": "integer", "minimum": 0 },
    "source_path_provenance": {
      "const": "coordinate_gaussian_prime_path"
    },
    "source_path": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_path_point" }
    },
    "terminal_source_inventory_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "digest_algorithm",
        "digest_hex",
        "max_norm_sq",
        "max_norm_atom_ids"
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "digest_algorithm": {
          "const": "sha256:lb_source_inventory_v1"
        },
        "digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_norm_sq": { "type": "integer", "minimum": 0 },
        "max_norm_atom_ids": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "terminal_source_inventory": {
      "type": "array",
      "items": { "type": "integer" }
    }
  },
  "$defs": {
    "source_path_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "norm_sq"],
      "properties": {
        "a": { "type": "integer", "minimum": 0 },
        "b": { "type": "integer", "minimum": 0 },
        "norm_sq": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
