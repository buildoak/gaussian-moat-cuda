{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaussian-moat.local/schemas/source-dead-gap.schema.json",
  "title": "LB source dead gap artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_label",
    "proof_status",
    "blocker",
    "non_claim",
    "k_sq",
    "terminal_radius",
    "target",
    "continuation_artifact",
    "bz_evidence",
    "bridge_safety",
    "target_path_provenance",
    "target_atom_path_length",
    "target_atom_path",
    "coordinate_path_obligation",
    "terminal_source_inventory_summary",
    "terminal_inventory_obligation",
    "missing_for_source_dead_cert"
  ],
  "properties": {
    "schema": { "const": "lb_source_k26_source_dead_gap_v1" },
    "claim_label": { "const": "SOURCE_ORIGIN_K26" },
    "proof_status": { "const": "DIAGNOSTIC_NON_CLAIM" },
    "blocker": {
      "enum": [
        "SOURCE_DEAD_CERT_COORDINATE_PATH_MISSING",
        "SOURCE_DEAD_CERT_TARGET_NOT_REACHED"
      ]
    },
    "non_claim": { "type": "string", "minLength": 1 },
    "k_sq": { "const": 26 },
    "terminal_radius": { "const": 1015645 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tsuchimura_endpoint", "canonical_octant_endpoint"],
      "properties": {
        "tsuchimura_endpoint": { "$ref": "#/$defs/point" },
        "canonical_octant_endpoint": { "$ref": "#/$defs/point" }
      }
    },
    "continuation_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "const": "k26-continuation-result.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "chunk_ledger_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "const": "k26-continuation-chunks.jsonl" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "bridge_source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "const": "k26-continuation-chunk-000.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "bz_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "accepted_for_schedule",
        "accepted_for_claim",
        "schedule_digest_algorithm",
        "schedule_digest_hex"
      ],
      "properties": {
        "status": { "const": "BZ_REPAIRED_SCHEDULE_PASS_NON_SOURCE" },
        "accepted_for_schedule": { "const": true },
        "accepted_for_claim": { "const": false },
        "schedule_digest_algorithm": {
          "const": "sha256:lb_source_k26_repaired_bz_schedule_v1"
        },
        "schedule_digest_hex": {
          "const": "7c820f641cc218631ddc2bc22c5767a70e8608ec4fdb293fadde6cc1fde57b95"
        }
      }
    },
    "bridge_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seam_bridge_policy",
        "source_coordinate_carry_atoms_with_next_band_candidates",
        "source_bridged_coordinate_carry_atoms",
        "source_unbridged_coordinate_carry_atoms",
        "source_unbridged_without_next_band_candidates",
        "source_unbridged_with_next_band_candidates",
        "source_unbridged_dead_end_candidate_atoms",
        "source_unbridged_unsafe_candidate_atoms",
        "source_bridge_rejected_candidate_atoms"
      ],
      "properties": {
        "seam_bridge_policy": { "const": "diagnostic_allow_unbridged" },
        "source_coordinate_carry_atoms_with_next_band_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "source_bridged_coordinate_carry_atoms": {
          "type": "integer",
          "minimum": 0
        },
        "source_unbridged_coordinate_carry_atoms": {
          "type": "integer",
          "minimum": 0
        },
        "source_unbridged_without_next_band_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "source_unbridged_with_next_band_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "source_unbridged_dead_end_candidate_atoms": {
          "type": "integer",
          "minimum": 0
        },
        "source_unbridged_unsafe_candidate_atoms": { "const": 0 },
        "source_bridge_rejected_candidate_atoms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target_path_provenance": {
      "enum": [
        "mixed_coordinate_port_atom_chain_non_claim",
        "component_reachability_only"
      ]
    },
    "target_atom_path_length": { "type": "integer", "minimum": 0 },
    "target_atom_path": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "coordinate_path_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_provenance",
        "observed_provenance",
        "observed_coordinate_atom_count",
        "observed_port_atom_count",
        "per_port_coordinate_expansion",
        "claim_grade_path_accepted"
      ],
      "properties": {
        "required_provenance": {
          "const": "coordinate_gaussian_prime_path"
        },
        "observed_provenance": {
          "enum": [
            "mixed_coordinate_port_atom_chain_non_claim",
            "component_reachability_only"
          ]
        },
        "observed_coordinate_atom_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_port_atom_count": {
          "type": "integer",
          "minimum": 0
        },
        "per_port_coordinate_expansion": { "const": "missing" },
        "claim_grade_path_accepted": { "const": false }
      }
    },
    "terminal_source_inventory_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "digest_algorithm",
        "digest_hex",
        "max_norm_sq",
        "max_norm_atom_ids"
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "digest_algorithm": { "const": "sha256:lb_source_inventory_v1" },
        "digest_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "max_norm_sq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1031522101121
        },
        "max_norm_atom_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        }
      }
    },
    "terminal_source_inventory_accumulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "provenance",
        "listed_inventory_present",
        "claim_grade_inventory_accepted",
        "count",
        "digest_algorithm",
        "digest_hex",
        "max_norm_sq",
        "max_norm_atom_ids"
      ],
      "properties": {
        "mode": { "const": "summary_digest_only_non_claim" },
        "provenance": {
          "const": "terminal_component_inventory_accumulator"
        },
        "listed_inventory_present": { "const": false },
        "claim_grade_inventory_accepted": { "const": false },
        "count": { "type": "integer", "minimum": 1 },
        "digest_algorithm": { "const": "sha256:lb_source_inventory_v1" },
        "digest_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "max_norm_sq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1031522101121
        },
        "max_norm_atom_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        }
      }
    },
    "terminal_inventory_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_mode",
        "observed_mode",
        "listed_inventory_present",
        "claim_grade_inventory_accepted",
        "observed_count",
        "observed_digest_algorithm",
        "observed_digest_hex",
        "observed_max_norm_sq"
      ],
      "properties": {
        "required_mode": { "const": "claim_grade_terminal_inventory" },
        "observed_mode": { "const": "summary_digest_only_non_claim" },
        "listed_inventory_present": { "const": false },
        "claim_grade_inventory_accepted": { "const": false },
        "observed_count": { "type": "integer", "minimum": 1 },
        "observed_digest_algorithm": {
          "const": "sha256:lb_source_inventory_v1"
        },
        "observed_digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_max_norm_sq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1031522101121
        }
      }
    },
    "missing_for_source_dead_cert": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "allOf": [
        {
          "contains": {
            "type": "string",
            "pattern": "coordinate Gaussian-prime source_path"
          }
        },
        {
          "contains": {
            "type": "string",
            "pattern": "terminal inventory"
          }
        },
        {
          "contains": {
            "type": "string",
            "pattern": "BZ schedule"
          }
        },
        {
          "contains": {
            "type": "string",
            "pattern": "verifier"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "blocker": {
            "const": "SOURCE_DEAD_CERT_COORDINATE_PATH_MISSING"
          }
        }
      },
      "then": {
        "properties": {
          "target_path_provenance": {
            "const": "mixed_coordinate_port_atom_chain_non_claim"
          },
          "target_atom_path_length": { "type": "integer", "minimum": 1 },
          "target_atom_path": { "type": "array", "minItems": 1 },
          "coordinate_path_obligation": {
            "properties": {
              "observed_provenance": {
                "const": "mixed_coordinate_port_atom_chain_non_claim"
              },
              "observed_coordinate_atom_count": {
                "type": "integer",
                "minimum": 1
              },
              "observed_port_atom_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "terminal_source_inventory_summary": {
            "properties": {
              "count": { "const": 14542615005 },
              "max_norm_sq": { "const": 1031522101121 }
            }
          },
          "terminal_inventory_obligation": {
            "properties": {
              "observed_count": { "const": 14542615005 },
              "observed_max_norm_sq": { "const": 1031522101121 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "blocker": {
            "const": "SOURCE_DEAD_CERT_TARGET_NOT_REACHED"
          }
        }
      },
      "then": {
        "properties": {
          "target_path_provenance": {
            "const": "component_reachability_only"
          },
          "target_atom_path_length": { "const": 0 },
          "target_atom_path": { "type": "array", "maxItems": 0 },
          "coordinate_path_obligation": {
            "properties": {
              "observed_provenance": {
                "const": "component_reachability_only"
              },
              "observed_coordinate_atom_count": { "const": 0 },
              "observed_port_atom_count": { "const": 0 }
            }
          },
          "terminal_source_inventory_summary": {
            "properties": {
              "max_norm_sq": { "type": "integer", "maximum": 1031522101120 }
            }
          },
          "terminal_inventory_obligation": {
            "properties": {
              "observed_max_norm_sq": {
                "type": "integer",
                "maximum": 1031522101120
              }
            }
          },
          "missing_for_source_dead_cert": {
            "contains": {
              "type": "string",
              "pattern": "target reachability"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "norm_sq"],
      "properties": {
        "a": { "type": "integer", "minimum": 0 },
        "b": { "type": "integer", "minimum": 0 },
        "norm_sq": { "const": 1031522101121 }
      }
    }
  }
}
